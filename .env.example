# From https://developer.spotify.com/dashboard -> your app -> Settings
SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI added in the app's settings
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: fills in genres for artists Spotify has none for.
# Free key at https://www.last.fm/api/account/create
LASTFM_API_KEY=
